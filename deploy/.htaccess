Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Preserve campaign links from the former /v2 preview routes.
RewriteRule ^v2/branding/?$ / [R=301,L,NE]
RewriteRule ^v2/lazer/?$ /lazer-epilasyon/ [R=301,L,NE]
RewriteRule ^v2/sac-tedavileri/?$ /sac-tedavileri/ [R=301,L,NE]
RewriteRule ^v2/yuz-germe/?$ /yuz-germe/ [R=301,L,NE]

# Serve existing files and directories, including retained WordPress uploads.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Resolve extensionless static exports when present.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|woff2?|webp|avif|png|jpe?g|svg|gif|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
